
# roar state — the generated setup stage runs `roar init`, which creates
# .roar/. Without this rule the worktree goes dirty and the FIRST PAID
# `roar run` refuses to execute ("Run blocked: untracked files").
.roar/
# --- reproduction outputs (scaffold_row.py: mnist rule) ---
# file-pattern ignore + tracked .gitkeep so each dir survives a clean
# checkout and roar keeps the outputs in lineage. NEVER dir-ignore.
DUMMY/*
!DUMMY/.gitkeep
outdir/*
!outdir/.gitkeep
# Python bytecode caches. The setup stage runs repro/preflight_cpu.py, which
# imports upstream's modules (hparams, layers, text, logger, ...) and therefore
# writes __pycache__ directories into the worktree BEFORE the first `roar run`.
# roar refuses to execute a traced step in a dirty worktree ("Run blocked:
# untracked files"), so without this rule the first PAID step never starts.
__pycache__/
*.py[cod]
# Local treqs binding (project/owner ids + the operator's username). Not part of
# the reproduction: `roar reproduce` reads the workflow, not this file. Ignored
# rather than committed so it can never leave a rebuilt worktree dirty, which
# would block the first traced step.
.treqs/config.toml
